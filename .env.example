# Copia este archivo a `.env` en la raiz del proyecto y completa los valores.
# El dashboard tiene su propio ejemplo: apps/dashboard/.env.example.

# --- Bot de Discord -----------------------------------------------------------

# Token del bot (Developer Portal > Bot > Reset Token). Obligatorio para `pnpm start` y `pnpm register`.
TOKEN=tu_token_discord

# ID de la aplicacion (Developer Portal > General Information). Obligatorio para `pnpm register`.
CLIENT_ID=tu_client_id

# Servidores donde `pnpm register` registra los comandos slash: IDs separados por comas.
GUILD_ID=123456789012345678,987654321098765432

# --- Persistencia -------------------------------------------------------------

# Base SQLite compartida entre el bot y el dashboard. Obligatoria.
# Una ruta relativa se resuelve desde prisma/schema.prisma (por defecto: ./data/nodewarbot.db).
DATABASE_URL="file:../data/nodewarbot.db"

# Opcional: directorio de datos (backups de `pnpm db:backup`, exportaciones JSON y los archivos
# heredados wars.json / garmoth-links.json). Si se deja vacio se usa ./data.
NODEWARBOT_DATA_DIR=
