# Copia este archivo a `apps/dashboard/.env.local` (Next.js lee los .env desde esta carpeta, no desde
# la raiz del repositorio) y completa los valores. Las variables del bot estan en el .env.example raiz.

# --- Discord OAuth (login) ----------------------------------------------------
# Developer Portal > OAuth2. Redirect URI: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Token del bot, solo en el servidor (nunca llega al navegador). Se usa para saber en que servidores
# esta instalado el bot y para publicar eventos. Si falta, se usa la variable TOKEN del entorno.
DISCORD_BOT_TOKEN=

# --- Sesion (NextAuth) --------------------------------------------------------
# Secreto largo y aleatorio, p. ej.: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publica del dashboard; debe coincidir exactamente con el Redirect URI configurado en Discord.
NEXTAUTH_URL=http://localhost:3000

# --- Base de datos ------------------------------------------------------------
# La misma SQLite que usa el bot. Una ruta relativa se resuelve desde prisma/schema.prisma.
DATABASE_URL="file:../data/nodewarbot.db"

# --- Opcionales ---------------------------------------------------------------
# Login con Google (solo identifica a la persona; no da acceso a servidores de Discord).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enlace para invitar al bot desde el panel de servidores. Alternativa: solo el ID de la aplicacion.
NEXT_PUBLIC_DISCORD_BOT_INVITE_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# ID de la aplicacion de Discord para consultar sus emojis. Si falta se usa DISCORD_CLIENT_ID,
# NEXT_PUBLIC_DISCORD_CLIENT_ID o CLIENT_ID.
DISCORD_APPLICATION_ID=
